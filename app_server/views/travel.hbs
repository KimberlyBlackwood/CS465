<html>
  <head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <h1>{{title}}</h1>

    <ul id="sites">
      {{#each trips}}
        <li>
          <img src="images/{{this.image}}" alt="{{this.name}}">
          <h2>{{this.name}}</h2>
          <p>{{this.description}}</p>
        </li>
      {{/each}}
    </ul>

  </body>
</html>

        